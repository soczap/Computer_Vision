# VIGIL configuration — copy to .env. All keys: vigil/config.py (prefix VIGIL_).
VIGIL_PORT=8090
VIGIL_HOST=0.0.0.0
VIGIL_TLS_CERT=certs/server.crt
VIGIL_TLS_KEY=certs/server.key
VIGIL_COOKIE_SECURE=true
# Existing FRS backend (read-only integration)
VIGIL_FRS_URL=https://127.0.0.1:8000
VIGIL_FRS_RELAY_WIDTH=1920
# Local LLM / VLM via Ollama
VIGIL_LLM_MODEL=qwen3.8:latest
VIGIL_VLM_MODEL=qwen3-vl:8b-instruct
VIGIL_TIMEZONE=Asia/Kolkata
# Optional
# VIGIL_ADMIN_PASSWORD=            # else generated into data/initial_admin_credentials.txt
# VIGIL_NOTIFY_WEBHOOK_URL=
# VIGIL_DATABASE_URL=postgresql+asyncpg://user:pass@host/vigil
